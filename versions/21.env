# versions/21.env -- JDK 21 sources and boot JDKs

JDK_TAG="jdk-21.0.10-ga"

# Boot JDKs; the suffix selects tool-jdk-<suffix> in versions/21.lock
VENDORS=(
    "21.0.10-tem"
    "21.0.10-amzn"
    "21.0.10-oracle"
    "21.0.10-librca"
    "21.0.10-zulu"
)

# DEFAULT_VERSION_DATE from make/conf/version-numbers.conf
SOURCE_DATE="2025-01-21"
