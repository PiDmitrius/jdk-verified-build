# versions/25.env -- JDK 25 sources and boot JDKs

JDK_TAG="jdk-25.0.5.0.3-ga"

# Boot JDKs; the suffix selects tool-jdk-<suffix> in versions/25.lock
VENDORS=(
    "25.0.5.0+8-tem"
    "25.0.5.0+9-amzn"
    "25.0.0.0-oracle"
    "25.0.5.0+11-librca"
    "25.0.5.0+8-zulu"
)

# DEFAULT_VERSION_DATE from make/conf/version-numbers.conf
SOURCE_DATE="2026-10-24"
