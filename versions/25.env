# versions/25.env -- JDK 25 sources and boot JDKs

JDK_TAG="jdk-25.0.5.0.3-ga"
JDK_REPO="https://github.com/openjdk/jdk25u"

# SDKMAN identifiers; each vendor publishes its own latest 25.x build
VENDORS=(
    "25.0.5.0+8-tem"
    "25.0.5.0+9-amzn"
    "25.0.0.0-oracle"
    "25.0.5.0+11-librca"
    "25.0.5.0+8-zulu"
)

# DEFAULT_VERSION_DATE from make/conf/version-numbers.conf
SOURCE_DATE="2026-10-24"
