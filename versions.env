# versions.env -- all versions and build parameters in one place
# Usage: source versions.env

# -- What to build --
JDK_MAJOR=21
JDK_TAG="jdk-21.0.10-ga"
JDK_REPO="https://github.com/openjdk/jdk21u"

# -- Boot JDK vendors (SDKMAN identifiers) --
BOOT_JDK_VERSION="21.0.10"
VENDORS=(
    "${BOOT_JDK_VERSION}-tem"
    "${BOOT_JDK_VERSION}-amzn"
    "${BOOT_JDK_VERSION}-oracle"
    "${BOOT_JDK_VERSION}-librca"
    "${BOOT_JDK_VERSION}-zulu"
)

# -- Branding (appears in java -version) --
VENDOR_NAME="PiDmitrius"
VENDOR_URL="https://github.com/PiDmitrius"

# -- Release date (for reproducibility, from version-numbers.conf) --
SOURCE_DATE="2025-01-21"

# -- Base Docker image --
BASE_IMAGE="registry.astralinux.ru/library/astra/ubi18:latest"

# -- Derived (do not edit) --
SOURCE_DATE_EPOCH=$(date -d "$SOURCE_DATE" +%s 2>/dev/null || date -j -f "%Y-%m-%d" "$SOURCE_DATE" +%s 2>/dev/null)
JDK_VERSION="${JDK_TAG#jdk-}"
JDK_VERSION="${JDK_VERSION%-ga}"
JDK_TARBALL_URL="${JDK_REPO}/archive/refs/tags/${JDK_TAG}.tar.gz"
PKG_NAME="openjdk-${JDK_MAJOR}-jdk"
PKG_VERSION="${JDK_VERSION}-1"
INSTALL_PREFIX="/usr/lib/jvm/java-${JDK_MAJOR}-openjdk-amd64"
